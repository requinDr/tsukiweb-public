{
	"name": "tsukiweb",
	"version": "1.1.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"start": "vite",
		"proxy": "vite --mode proxy",
		"common:check": "tsc -p tsukiweb-common/tsconfig.json",
		"common:update": "git submodule update --remote --merge tsukiweb-common && npm install",
		"build": "npm run common:check && tsc && vite build"
	},
	"dependencies": {
		"@tanstack/react-virtual": "^3.14.12",
		"@tsukiweb/common": "file:tsukiweb-common",
		"classnames": "^2.5.1",
		"motion": "^13.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-error-boundary": "^6.1.5",
		"react-icons": "^5.7.0",
		"react-toastify": "^11.1.0",
		"sass": "^1.104.1",
		"wouter": "^3.11.0",
		"yet-another-react-lightbox": "^3.32.2"
	},
	"devDependencies": {
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
